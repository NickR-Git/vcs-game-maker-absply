screenshot: data:image/png;base64,
configuration:
  projectTitle: Infinite Playfield Scroll with SuperChip
  projectDeveloper: AbstractPolygon
  projectVersion: 1.0.0
  projectWebsite: https://abstractpolygon.com/
  projectDescription: An example of an infinitely scrolling playfield, this time
    using Superchip RAM for a higher playfield resolution.
  showScore: false
  enableScoreFade: false
  showBlankLines: true
  enablePlayer0SpriteColors: true
  enablePlayer1SpriteColors: true
  enablePfColors: true
  enableSuperchip: true
  enableOptimizationSpeed: false
  enableInlineRand: true
  enableRand16: true
  enableCycleScore: false
  enableScanlinesDebug: false
  pfres: 24
  enablePfRowHeight: false
  pfrowheight: 8
  tvStandard: ntsc
  romSize: 8k
  scoreFont: ""
  muteAllAudio: false
  showVariableComments: true
