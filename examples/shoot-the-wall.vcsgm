configuration:
  projectTitle: Shoot the Wall
  projectDeveloper: Nick R.
  projectVersion: 1.0.0
  projectDescription: Move Player 0 up and down with the joystick and hold fire to
    shoot Missile 0 at the playfield. When the missile hits, the blocks work out
    which playfield pixel it touched ("Find playfield pixel Missile 0 collided
    with") and clear exactly that pixel, the same way Yars' Revenge shot holes
    in the Qotile's shield.
blockly-workspace: "<xml xmlns=\"https://developers.google.com/blockly/xml\">\r

  \  <block type=\"event_block\" x=\"20\" y=\"20\">\r

  \    <field name=\"EVENT\">system_start</field>\r

  \    <statement name=\"DO\">\r

  \      <block type=\"event_change_state\">\r

  \        <field name=\"STATE\">gameplay</field>\r

  \      </block>\r

  \    </statement>\r

  \  </block>\r

  \  <block type=\"event_block\" x=\"20\" y=\"140\">\r

  \    <field name=\"EVENT\">gameplay_start</field>\r

  \    <statement name=\"DO\">\r

  \      <block type=\"sprite_player_set\">\r

  \        <field name=\"PLAYER\">0</field>\r

  \        <field name=\"VAR\">player0x</field>\r

  \        <field name=\"LOOP\">TRUE</field>\r

  \        <value name=\"VALUE\"><shadow type=\"math_number\"><field
  name=\"NUM\">40</field></shadow></value>\r

  \        <next>\r

  \          <block type=\"sprite_player_set\">\r

  \            <field name=\"PLAYER\">0</field>\r

  \            <field name=\"VAR\">player0y</field>\r

  \            <field name=\"LOOP\">TRUE</field>\r

  \            <value name=\"VALUE\"><shadow type=\"math_number\"><field
  name=\"NUM\">50</field></shadow></value>\r

  \          </block>\r

  \        </next>\r

  \      </block>\r

  \    </statement>\r

  \    <next>\r

  \      <block type=\"event_block\">\r

  \        <field name=\"EVENT\">gameplay_update</field>\r

  \        <statement name=\"DO\">\r

  \          <block type=\"controls_if\">\r

  \            <value name=\"IF0\">\r

  \              <block type=\"input_joy0_get\"><field
  name=\"VAR\">joy0up</field></block>\r

  \            </value>\r

  \            <statement name=\"DO0\">\r

  \              <block type=\"sprite_player_change\">\r

  \                <field name=\"PLAYER\">0</field>\r

  \                <field name=\"VAR\">player0y</field>\r

  \                <value name=\"DELTA\"><shadow type=\"math_number\"><field
  name=\"NUM\">-1</field></shadow></value>\r

  \              </block>\r

  \            </statement>\r

  \            <next>\r

  \              <block type=\"controls_if\">\r

  \                <value name=\"IF0\">\r

  \                  <block type=\"input_joy0_get\"><field
  name=\"VAR\">joy0down</field></block>\r

  \                </value>\r

  \                <statement name=\"DO0\">\r

  \                  <block type=\"sprite_player_change\">\r

  \                    <field name=\"PLAYER\">0</field>\r

  \                    <field name=\"VAR\">player0y</field>\r

  \                    <value name=\"DELTA\"><shadow
  type=\"math_number\"><field name=\"NUM\">1</field></shadow></value>\r

  \                  </block>\r

  \                </statement>\r

  \                <next>\r

  \                  <block type=\"event_frame_every_n\">\r

  \                    <field name=\"MASK\">15</field>\r

  \                    <field name=\"DELTA\">0</field>\r

  \                    <statement name=\"DO\">\r

  \                      <block type=\"controls_if\">\r

  \                        <value name=\"IF0\">\r

  \                          <block type=\"input_joy0_get\"><field
  name=\"VAR\">joy0fire</field></block>\r

  \                        </value>\r

  \                        <statement name=\"DO0\">\r

  \                          <block type=\"sprite_missile_set\">\r

  \                            <field name=\"MISSILE\">0</field>\r

  \                            <field name=\"VAR\">missile0height</field>\r

  \                            <value name=\"VALUE\"><shadow
  type=\"math_number\"><field name=\"NUM\">2</field></shadow></value>\r

  \                            <next>\r

  \                              <block type=\"sprite_missile_fire\">\r

  \                                <field name=\"MISSILE\">0</field>\r

  \                                <field name=\"DEFAULT_ANGLE\">2</field>\r

  \                                <field name=\"SPEED\">3</field>\r

  \                                <field name=\"THROTTLE\">FALSE</field>\r

  \                                <field
  name=\"DIRECTIONS16\">FALSE</field>\r

  \                                <value name=\"X\">\r

  \                                  <shadow type=\"math_number\"><field
  name=\"NUM\">0</field></shadow>\r

  \                                  <block type=\"sprite_player_get\"><field
  name=\"PLAYER\">0</field><field name=\"VAR\">player0x</field></block>\r

  \                                </value>\r

  \                                <value name=\"Y\">\r

  \                                  <shadow type=\"math_number\"><field
  name=\"NUM\">0</field></shadow>\r

  \                                  <block type=\"sprite_player_get\"><field
  name=\"PLAYER\">0</field><field name=\"VAR\">player0y</field></block>\r

  \                                </value>\r

  \                                <value name=\"ANGLE\"><shadow
  type=\"math_number\"><field name=\"NUM\">2</field></shadow></value>\r

  \                              </block>\r

  \                            </next>\r

  \                          </block>\r

  \                        </statement>\r

  \                      </block>\r

  \                    </statement>\r

  \                    <next>\r

  \                      <block type=\"controls_if\">\r

  \                        <value name=\"IF0\">\r

  \                          <block type=\"collision_get\">\r

  \                            <field name=\"VAR0\">missile0</field>\r

  \                            <field name=\"VAR1\">playfield</field>\r

  \                          </block>\r

  \                        </value>\r

  \                        <statement name=\"DO0\">\r

  \                          <block
  type=\"background_collision_pixel_direction\">\r

  \                            <field name=\"SPRITE\">missile0</field>\r

  \                            <value name=\"DIRECTION\"><shadow
  type=\"math_number\"><field name=\"NUM\">2</field></shadow></value>\r

  \                            <next>\r

  \                              <block type=\"background_change_pixel\">\r

  \                                <field name=\"OPERATION\">off</field>\r

  \                                <value name=\"X\"><shadow
  type=\"math_number\"><field name=\"NUM\">0</field></shadow><block
  type=\"background_collision_pixel_column\"></block></value>\r

  \                                <value name=\"Y\"><shadow
  type=\"math_number\"><field name=\"NUM\">0</field></shadow><block
  type=\"background_collision_pixel_row\"></block></value>\r

  \                                <next>\r

  \                                  <block type=\"sprite_missile_set\">\r

  \                                    <field name=\"MISSILE\">0</field>\r

  \                                    <field
  name=\"VAR\">missile0height</field>\r

  \                                    <value name=\"VALUE\"><shadow
  type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\r

  \                                  </block>\r

  \                                </next>\r

  \                              </block>\r

  \                            </next>\r

  \                          </block>\r

  \                        </statement>\r

  \                      </block>\r

  \                    </next>\r

  \                  </block>\r

  \                </next>\r

  \              </block>\r

  \            </next>\r

  \          </block>\r

  \        </statement>\r

  \      </block>\r

  \    </next>\r

  \  </block>\r

  </xml>\r\n"
